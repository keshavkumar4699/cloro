# --- Required ---
DATABASE_URL="postgresql://cloro:cloro@localhost:5432/cloro"
# Generate with: npx auth secret
AUTH_SECRET=""
# Public URL of the site (used for guardian links and OAuth callbacks)
AUTH_URL="http://localhost:3000"

# --- Google sign-in (the only login method) ---
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: <AUTH_URL>/api/auth/callback/google
# Enable the "People API" so Cloro can read the account's birthday.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Aadhaar Secure QR verification ---
# UIDAI's public key for Secure QR signatures, as PEM (\n escapes allowed).
UIDAI_PUBLIC_KEY_PEM=""
# Secret used to fingerprint identities to block duplicate accounts. Never change it after launch.
AADHAAR_HASH_SECRET=""
# Development only: accept QR codes without checking UIDAI's signature.
AADHAAR_ALLOW_UNSIGNED=false

# --- Listing pass for 24–30 year olds ---
LISTING_FEE_24_30=299
# Leave empty to use the mock provider in development.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# --- Photo storage ---
# "local" (default, ./uploads) or "s3" for any S3-compatible bucket such as Cloudflare R2.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=""
S3_REGION=auto
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# --- Auction settlement cron ---
# Call GET /api/cron/settle with "Authorization: Bearer <CRON_SECRET>" every few minutes.
CRON_SECRET=""

# --- Local development only ---
# Shows an email-only developer login on /signin (ignored in production).
DEV_LOGIN=false
