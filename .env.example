# ──────────────────────────────────────────────────────────────────────────────
# Cloro settings. Copy to .env and fill in. Never commit .env.
# Generate random secrets with:  openssl rand -base64 48
# ──────────────────────────────────────────────────────────────────────────────

# --- Your site ---
DOMAIN="cloro.in"                     # used by Caddy for free HTTPS (docker-compose.prod.yml)
SITE_URL="https://cloro.in"           # public address, used for SEO, sitemaps and links
AUTH_URL="https://cloro.in"           # same as SITE_URL

# --- Database ---
# With docker-compose.prod.yml, only set the password; the app's DATABASE_URL is built for you.
POSTGRES_PASSWORD=""
# For local development without Docker:
DATABASE_URL="postgresql://cloro:cloro@localhost:5432/cloro"

# --- Sign-in (Google only) ---
AUTH_SECRET=""                        # 32+ random characters
AUTH_GOOGLE_ID=""                     # Google Cloud → APIs & Services → Credentials → OAuth client (Web)
AUTH_GOOGLE_SECRET=""                 # Redirect URI: https://cloro.in/api/auth/callback/google
# Reading birthdays from Google needs Google's app review (otherwise a 100-user cap). Keep false.
GOOGLE_BIRTHDAY_SCOPE=false

# --- Aadhaar Secure QR verification ---
UIDAI_PUBLIC_KEY_PEM=""               # UIDAI's Secure QR certificate (PEM text; \n escapes allowed)
AADHAAR_HASH_SECRET=""                # 32+ random characters. NEVER change after launch.
AADHAAR_ALLOW_UNSIGNED=false          # development only

# --- Auction cron (closes auctions, sends reminders) ---
CRON_SECRET=""                        # 16+ random characters

# --- Photos ---
# "local" stores photos on the server's disk (fine on a VPS with docker-compose.prod.yml).
# "s3" uses any S3-compatible bucket, e.g. Cloudflare R2 (10 GB free, no bandwidth fees).
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=""
S3_REGION=auto
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# --- Listing pass for members aged 24–30 (Razorpay) ---
LISTING_FEE_24_30=299
RAZORPAY_KEY_ID=""                    # leave all three empty until your Razorpay account is approved
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""            # Razorpay → Settings → Webhooks → https://cloro.in/api/razorpay/webhook

# --- Shown on the Contact and legal pages (Razorpay and Google check these) ---
BUSINESS_NAME="Cloro"
CONTACT_EMAIL="support@cloro.in"
CONTACT_ADDRESS=""
GRIEVANCE_OFFICER=""                  # name of the person handling privacy complaints (DPDP Act)

# --- Search engines ---
GOOGLE_SITE_VERIFICATION=""           # from Google Search Console (HTML tag method), optional

# --- Off-site database backups (optional but recommended) ---
BACKUP_S3_BUCKET=""                   # e.g. a private Cloudflare R2 bucket "cloro-backups"
BACKUP_S3_ENDPOINT=""
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""

# --- Local development only (ignored in production) ---
DEV_LOGIN=false
